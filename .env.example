# Server
PORT=3000
NODE_ENV=development

# Database (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumora

# Redis (optional — used by rate limiting / queues when present)
REDIS_URL=redis://localhost:6379

# Auth (required)
JWT_SECRET=change-me-dev-secret-at-least-16-chars
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-16-chars

# Auth tokens (optional — sensible defaults)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Object storage (optional)
S3_BUCKET=
S3_REGION=

# Stellar
STELLAR_NETWORK=testnet
# Horizon base URL override (optional — defaults to the matching network's
# public Horizon: horizon-testnet.stellar.org / horizon.stellar.org)
STELLAR_HORIZON_URL=
# Escrow account that order payments are sent to (optional). When unset,
# payments go directly to the seller's linked wallet and the platform fee is
# sent to STELLAR_PLATFORM_FEE_ADDRESS below.
STELLAR_ESCROW_ADDRESS=
# Account that receives the platform fee when no escrow account is used (optional).
STELLAR_PLATFORM_FEE_ADDRESS=
# Lifetime of a signed payment-intent transaction, in seconds (optional, default 300).
PAYMENT_INTENT_TTL_SECONDS=300

# Prisma connection pool size per instance (optional, positive integer, default 20).
# A connection_limit already present in DATABASE_URL takes precedence.
DATABASE_POOL_SIZE=20
# Days a revoked refresh token is kept for audit before the daily cleanup job
# deletes it (optional, default 30). Expired tokens are deleted immediately.
REVOKED_TOKEN_RETENTION_DAYS=30
# Asset issuer accounts (optional). USDC defaults to Circle's public issuer.
# EURC and NGNT have no default and are required when NODE_ENV=production.
USDC_ASSET_ISSUER=
EURC_ASSET_ISSUER=
NGNT_ASSET_ISSUER=

# bcrypt cost factor for password hashing (optional, integer 10-15, default 12;
# tests automatically use 4).
BCRYPT_COST=

# Commission deliverable revisions (optional — default 3).
# How many times a client may send a submission back for changes.
MAX_COMMISSION_REVISIONS=3

# SMTP (optional — all four must be set together)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# CORS — comma-separated allowed origins.
# Leave empty to reflect the request origin (any origin allowed with credentials).
CORS_ORIGIN=http://localhost:3000
